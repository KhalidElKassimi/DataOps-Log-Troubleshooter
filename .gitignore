# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Exclude binaries
*.exe
*.zip

# Exclude generated Python bytecode
__pycache__/
*.pyc

# Exclude environment variables
.env
.env.local
.env.*.local

# Ignore documentation folder
docs/

